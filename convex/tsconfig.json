{
  "compilerOptions": {
    "types": ["node"], "allowJs": true, "strict": true, "moduleResolution": "Bundler",
    "target": "ESNext", "module": "ESNext", "lib": ["ES2023", "DOM"],
    "skipLibCheck": true, "resolveJsonModule": true, "noEmit": true, "isolatedModules": true
  },
  "include": ["./**/*.ts"],
  "exclude": ["./_generated"]
}
